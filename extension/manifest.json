{
    "manifest_version": 3,
    "name": "Nynx Shield",
    "version": "1.0.0",
    "description": "A powerful, privacy-focused ad blocker built with Manifest V3",
    "permissions": [
        "declarativeNetRequest",
        "declarativeNetRequestWithHostAccess",
        "declarativeNetRequestFeedback",
        "scripting",
        "storage",
        "tabs"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "action": {
        "default_popup": "pages/popup.html",
        "default_icon": {
            "16": "assets/icons/icon128.png",
            "48": "assets/icons/icon128.png",
            "128": "assets/icons/icon128.png"
        }
    },
    "options_page": "pages/options.html",
    "icons": {
        "16": "assets/icons/icon128.png",
        "48": "assets/icons/icon128.png",
        "128": "assets/icons/icon128.png"
    },
    "background": {
        "service_worker": "js/background.js",
        "scripts": [
            "js/background.js"
        ]
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "js/content.js"
            ]
        }
    ],
    "declarative_net_request": {
        "rule_resources": [
            {
                "id": "ruleset_1",
                "enabled": true,
                "path": "rules/rules.json"
            }
        ]
    }
}